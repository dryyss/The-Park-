supported-architectures[os][]=linux
supported-architectures[os][]=win32
supported-architectures[cpu][]=x64
# Les binaires précompilés de sharp sont déclarés par libc : @img/sharp-linux-x64
# exige glibc, @img/sharp-linuxmusl-x64 exige musl. Sans cette clé, pnpm se
# rabat sur la libc de la machine qui installe — indéterminée sous Windows, d'où
# un binaire non récupéré au build Linux, un repli sur compilation source et un
# échec faute de node-gyp. Next.js embarque sa propre copie de sharp pour
# l'optimiseur d'images : la perdre dégrade toutes les images de cartes.
supported-architectures[libc][]=glibc
supported-architectures[libc][]=musl
